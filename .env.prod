# Production values must be supplied by the deployment secret manager.
MONGO_URL=
DATABASE_NAME=autovid_db
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REDIS_URL=
CORS_ORIGINS=https://app.example.com
LOCAL_MEDIA_ROOT=media
VIDEO_WORKER_CONCURRENCY=2
IMAGE_WORKER_CONCURRENCY=2
TTS_WORKER_CONCURRENCY=1
FFMPEG_THREADS=1
MAX_RENDER_RETRIES=2

# Render capacity: start at 2; validate server capacity before increasing to 10.
CELERY_RENDER_CONCURRENCY=2
MAX_CONCURRENT_VIDEO_RENDERS=2
FFMPEG_FILTER_THREADS=1
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_WORKER_MAX_MEMORY_PER_CHILD_KB=768000
CELERY_WORKER_MAX_TASKS_PER_CHILD=25
UPLOAD_PROCESSING_CONCURRENCY=2
RENDER_MIN_FREE_MEMORY_MB=1024
RENDER_MEMORY_PER_PROCESS_MB=512
MAX_PENDING_RENDER_JOBS=500
MAX_VIDEO_UPLOAD_MB=250
MAX_SOURCE_VIDEO_SECONDS=1800
MAX_OUTPUT_VIDEO_SECONDS=900
MAX_OUTPUT_WIDTH=1280
MAX_OUTPUT_HEIGHT=720
FFMPEG_TIMEOUT_SECONDS=600
FFMPEG_PRESET=veryfast
FFMPEG_CRF=22
FFMPEG_COMPOSE_AT_OUTPUT_SIZE=true
REMOTE_ASSET_CACHE=true
STALE_JOB_SECONDS=900
CELERY_VISIBILITY_TIMEOUT_SECONDS=86400
RENDER_LOCK_DIR=/var/lib/autovid/render_locks
APP_ENV=production
RENDER_QUEUE_BACKEND=celery
CELERY_BEAT_SCHEDULE=/var/lib/autovid/celerybeat-schedule
BACKEND_LOG_LEVEL=INFO
