# # rename to .env and fill values
# MONGO_URL=mongodb://mongo:27017
# DATABASE_NAME=autovid_db

# SECRET_KEY=replace_this_with_a_strong_secret
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=60

# REDIS_BROKER=redis://redis:6379/0

# AWS_ACCESS_KEY_ID=your_aws_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret
# AWS_REGION=ap-south-1
# S3_BUCKET=your-bucket-name


MONGO_URL=mongodb://localhost:27017
DATABASE_NAME=autovid_db
SECRET_KEY=generate-a-unique-random-secret-of-at-least-32-bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
DEBUG=TRUE
MEDIA_ROOT=media
LOCAL_MEDIA_ROOT=media
CORS_ORIGINS=http://localhost:3000
REDIS_URL=redis://localhost:6379/0
APP_ENV=development
RENDER_QUEUE_BACKEND=memory
MAX_IMAGE_UPLOAD_MB=10
MAX_VIDEO_UPLOAD_MB=250
MAX_AUDIO_UPLOAD_MB=25
MAX_AUDIO_SECONDS=600
MAX_IMAGE_WIDTH=8192
MAX_IMAGE_HEIGHT=8192
VIDEO_WORKER_CONCURRENCY=100
IMAGE_WORKER_CONCURRENCY=4
TTS_WORKER_CONCURRENCY=2
FFMPEG_THREADS=2
MAX_RENDER_RETRIES=2
FFMPEG_PRESET=veryfast
FFMPEG_CRF=22
FFMPEG_COMPOSE_AT_OUTPUT_SIZE=true
REQUEST_RATE_LIMIT_PER_MINUTE=120
UPLOAD_RATE_LIMIT_PER_MINUTE=120
RENDER_RATE_LIMIT_PER_MINUTE=120
TTS_RATE_LIMIT_PER_MINUTE=10
STALE_JOB_SECONDS=900

# Optional one-time bootstrap. Remove these values after the first admin exists.
# BOOTSTRAP_SUPERADMIN_EMAIL=admin@example.com
# BOOTSTRAP_SUPERADMIN_PASSWORD=use-a-secret-manager-value
# BOOTSTRAP_SUPERADMIN_USERNAME=Super Admin

UPLOAD_PROCESSING_CONCURRENCY=4
CELERY_VISIBILITY_TIMEOUT_SECONDS=86400
