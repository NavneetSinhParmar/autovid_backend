[Unit]
Description=AutoVid video worker
After=network-online.target redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=autovid
Group=autovid
WorkingDirectory=/var/www/autovid_backend
EnvironmentFile=/var/www/autovid_backend/.env
EnvironmentFile=/var/www/autovid_backend/deploy/capacity.env
ExecStart=/var/www/autovid_backend/.venv/bin/python scripts/run_worker.py render_video
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=1800
SendSIGKILL=no
UMask=0027
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
